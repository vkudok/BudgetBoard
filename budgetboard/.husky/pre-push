#!/usr/bin/env sh

has_budgetboard_changes=0
zero_oid=0000000000000000000000000000000000000000

while read local_ref local_oid remote_ref remote_oid
do
  # Be tolerant to CRLF input on Windows shells.
  local_oid=$(printf '%s' "$local_oid" | tr -d '\r')
  remote_oid=$(printf '%s' "$remote_oid" | tr -d '\r')

  # Branch/tag deletion: there is no local content to validate.
  if [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi

  if [ "$remote_oid" = "$zero_oid" ]; then
    # New remote ref: compare with the current branch upstream when it exists.
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)

    if [ -n "$upstream" ]; then
      changed_files=$(git diff --name-only "$upstream" "$local_oid")
    else
      changed_files=$(git diff-tree --no-commit-id --name-only -r "$local_oid")
    fi
  else
    changed_files=$(git diff --name-only "$remote_oid" "$local_oid")
  fi

  if printf '%s\n' "$changed_files" | grep -q '^budgetboard/'; then
    has_budgetboard_changes=1
    break
  fi
done

if [ "$has_budgetboard_changes" != "1" ]; then
  echo "pre-push: no budgetboard changes, skipping frontend lint"
  exit 0
fi

cd budgetboard
npm run lint